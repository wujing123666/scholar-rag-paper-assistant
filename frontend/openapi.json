{
  "openapi": "3.1.0",
  "info": {
    "title": "ScholarRAG API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/papers": {
      "get": {
        "summary": "Papers",
        "operationId": "papers_api_v1_papers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/papers/{paper_id}": {
      "get": {
        "summary": "Paper",
        "operationId": "paper_api_v1_papers__paper_id__get",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paper Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paper"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/papers/{paper_id}/files/{file_id}": {
      "get": {
        "summary": "Source",
        "operationId": "source_api_v1_papers__paper_id__files__file_id__get",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paper Id"
            }
          },
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/answers": {
      "post": {
        "summary": "Answers",
        "operationId": "answers_api_v1_answers_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/paper-searches": {
      "post": {
        "summary": "Searches",
        "operationId": "searches_api_v1_paper_searches_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Job",
        "operationId": "job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "refused",
              "evidence_only"
            ],
            "title": "Status"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "verification": {
            "$ref": "#/components/schemas/Verification"
          },
          "source": {
            "type": "string",
            "const": "api",
            "title": "Source",
            "default": "api"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "claims",
          "citations",
          "reason",
          "verification"
        ],
        "title": "AnswerResult"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ApiError"
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "paper_id": {
            "type": "string",
            "title": "Paper Id"
          },
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "paper_title": {
            "type": "string",
            "title": "Paper Title"
          },
          "page_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Number"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "citation_id",
          "paper_id",
          "file_id",
          "paper_title",
          "page_number",
          "section",
          "chunk_id",
          "excerpt"
        ],
        "title": "Citation"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "citations"
        ],
        "title": "Claim"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "papers_count": {
            "type": "integer",
            "title": "Papers Count"
          },
          "verification_mode": {
            "type": "string",
            "title": "Verification Mode"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ready",
          "dataset_id",
          "label",
          "papers_count",
          "verification_mode",
          "session_id"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "answer",
              "search"
            ],
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "queue_timeout",
              "interrupted"
            ],
            "title": "State"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnswerResult"
              },
              {
                "$ref": "#/components/schemas/SearchResult"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "dataset_id",
          "kind",
          "state"
        ],
        "title": "Job"
      },
      "Paper": {
        "properties": {
          "paper_id": {
            "type": "string",
            "title": "Paper Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "canonical_title": {
            "type": "string",
            "title": "Canonical Title"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors"
          },
          "year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/PaperFile"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paper_id",
          "title",
          "canonical_title",
          "authors",
          "year",
          "venue",
          "tags",
          "summary",
          "files"
        ],
        "title": "Paper"
      },
      "PaperFile": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_id",
          "name",
          "url"
        ],
        "title": "PaperFile"
      },
      "PaperList": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "papers": {
            "items": {
              "$ref": "#/components/schemas/Paper"
            },
            "type": "array",
            "title": "Papers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "papers"
        ],
        "title": "PaperList"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "paper_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Paper Ids"
          },
          "dataset_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Dataset Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "dataset_id"
        ],
        "title": "QueryRequest"
      },
      "SearchResult": {
        "properties": {
          "papers": {
            "items": {
              "$ref": "#/components/schemas/Paper"
            },
            "type": "array",
            "title": "Papers"
          },
          "rejected": {
            "type": "boolean",
            "title": "Rejected"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "papers",
          "rejected",
          "reason"
        ],
        "title": "SearchResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "skipped",
              "unavailable"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Verification"
      }
    }
  }
}
